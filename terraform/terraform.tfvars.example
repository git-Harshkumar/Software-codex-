# =============================================================================
# AWS Free Tier Deployment Variables
# Copy this file to terraform.tfvars:
#   cp terraform.tfvars.example terraform.tfvars
# =============================================================================

# AWS region (e.g. us-east-1, us-west-2, ap-south-1 for Mumbai, eu-central-1 for Frankfurt)
aws_region = "us-east-1"

# Project tag prefix
project_name = "ai-lecture-notes"

# EC2 Instance Type (t2.micro is 100% Free Tier; t3.micro in regions where t2 is unavailable)
instance_type = "t2.micro"

# Root disk size in GB (Free Tier allows up to 30 GB)
disk_size_gb = 20

# Allowed IP for SSH. "0.0.0.0/0" allows anywhere; replace with your IP like "203.0.113.50/32" for strict security
allowed_ssh_cidr = "0.0.0.0/0"

# Optional: Google Gemini API key to automatically inject into the server's .env
# If left empty, you can also edit /var/www/lecturenotes/.env via SSH
gemini_api_key = ""
